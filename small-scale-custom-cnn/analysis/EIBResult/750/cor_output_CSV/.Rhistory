#combine data
EIB_repres_500_within_slope_0.005$slope<-0.005
EIB_repres_500_within_slope_0.05$slope<-0.05
EIB_repres_500_within_slope_0.5$slope<-0.5
EIB_repres_500_between_slope_0.005$slope<-0.005
EIB_repres_500_between_slope_0.05$slope<-0.05
EIB_repres_500_between_slope_0.5$slope<-0.5
EIB_repres_500_within<-rbind.data.frame(EIB_repres_500_within_slope_0.005,EIB_repres_500_within_slope_0.05,EIB_repres_500_within_slope_0.5)
EIB_repres_500_between<-rbind.data.frame(EIB_repres_500_between_slope_0.005,EIB_repres_500_between_slope_0.05,EIB_repres_500_between_slope_0.5)
EIB_repres_500_within$Sub<-paste0("Sub",1:nrow(EIB_repres_500_within))
EIB_repres_500_between$Sub<-paste0("Sub",1:nrow(EIB_repres_500_between))
EIB_repres_500_within$Type<-"Within"
EIB_repres_500_between$Type<-"Between"
require(Rmisc)
require(reshape2)
require(ggplot2)
require(ggbeeswarm)
EIB_repres_500_within_long<-melt(EIB_repres_500_within,id.vars = c("Sub","slope","Type"),variable.name = "pair",value.name = "corr")
EIB_repres_500_betw_long<-melt(EIB_repres_500_between,id.vars = c("Sub","slope","Type"),variable.name = "pair",value.name = "corr")
EIB_repres_500_long<-rbind.data.frame(EIB_repres_500_within_long,EIB_repres_500_betw_long)
EIB_repres_500_long$Sub<-as.factor(EIB_repres_500_long$Sub)
EIB_repres_500_long$slope<-as.factor(EIB_repres_500_long$slope)
EIB_repres_500_long$slope<-factor(EIB_repres_500_long$slope,levels = c("0.005","0.05","0.5"))
##ANOVA
require(rstatix)
EIB_repres_500_sum<-summarySE(EIB_repres_500_long,measurevar = "corr",groupvars = c("Sub","slope","Type"),na.rm = T)
anova_test(corr~slope*Type+Error(Sub/Type),data=EIB_repres_500_sum,effect.size = "pes",type = 3)
##post hoc
aov(corr~slope, data = EIB_repres_500_sum[EIB_repres_500_sum$Type=="Within",]) %>% tukey_hsd()
EIB_repres_500_sum
##plot
EIB_repres_500_grand_sum<-summarySE(EIB_repres_500_sum[,c(1,2,3,5)],measurevar = "corr",groupvars = c("slope","Type"),na.rm = T)
EIB_repres_500_grand_sum
##post hoc
aov(corr~slope, data = EIB_repres_500_sum[EIB_repres_500_sum$Type=="Within",]) %>% tukey_hsd()
aov(corr~slope, data = EIB_repres_500_sum[EIB_repres_500_sum$Type=="Between",]) %>% tukey_hsd()
