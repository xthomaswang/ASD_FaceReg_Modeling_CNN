EIB_repres_750_betw_long<-melt(EIB_repres_750_between,id.vars = c("Sub","slope","Type"),variable.name = "pair",value.name = "corr")
EIB_repres_750_long<-rbind.data.frame(EIB_repres_750_within_long,EIB_repres_750_betw_long)
