###750 epoch
#read in the data & ###calculate the within-P vs. between-P correlation
setwd("/Users/lchen4/Documents/Research/LCCN related/ASD Face Memory_Modeling/Data analysis/EIBResult/750/cor_output_CSV/")
require(magic)
##construct diagnal matrix
dia_matrix<-matrix(T, 4, 4)
dia_matrix_block<-adiag(dia_matrix,dia_matrix,dia_matrix,dia_matrix,dia_matrix,dia_matrix,dia_matrix,dia_matrix,dia_matrix,dia_matrix)
for (j in c(0.5,0.05,0.005)) {
for (i in 0:19) {
cor_temp<-read.csv(paste0("cor_output_750_",j,"_",i,".csv"),header = T, na.strings = "NA")[,-1]
###remove the first image of all P identity (which is used for testing)
cor_temp<-cor_temp[-which(1:nrow(cor_temp)%%5==1),-which(1:ncol(cor_temp)%%5==1)]
if (i == 0) {
EIB_mean_repres<-cor_temp
assign(paste0("EIB_repres_750_within_slope_",j), cor_temp[(lower.tri(cor_temp) & dia_matrix_block)])
assign(paste0("EIB_repres_750_between_slope_",j), cor_temp[(lower.tri(cor_temp) & !dia_matrix_block)])
} else {
EIB_mean_repres<-EIB_mean_repres+cor_temp
assign(paste0("EIB_repres_750_within_slope_",j), rbind.data.frame(get(paste0("EIB_repres_750_within_slope_",j)),
cor_temp[(lower.tri(cor_temp) & dia_matrix_block)]))
assign(paste0("EIB_repres_750_between_slope_",j), rbind.data.frame(get(paste0("EIB_repres_750_between_slope_",j)),
cor_temp[(lower.tri(cor_temp) & !dia_matrix_block)]))
}
}
assign(paste0("EIB_mean_repres_slope_",j),EIB_mean_repres/20)
}
colnames(EIB_repres_750_within_slope_0.005)<-paste0("wcor",1:dim(EIB_repres_750_within_slope_0.005)[2])
colnames(EIB_repres_750_within_slope_0.05)<-paste0("wcor",1:dim(EIB_repres_750_within_slope_0.05)[2])
colnames(EIB_repres_750_within_slope_0.5)<-paste0("wcor",1:dim(EIB_repres_750_within_slope_0.5)[2])
colnames(EIB_repres_750_between_slope_0.005)<-paste0("bcor",1:dim(EIB_repres_750_between_slope_0.005)[2])
colnames(EIB_repres_750_between_slope_0.05)<-paste0("bcor",1:dim(EIB_repres_750_between_slope_0.05)[2])
colnames(EIB_repres_750_between_slope_0.5)<-paste0("bcor",1:dim(EIB_repres_750_between_slope_0.5)[2])
