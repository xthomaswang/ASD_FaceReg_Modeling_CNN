EIB_repres_750_within<-rbind.data.frame(EIB_repres_750_within_slope_0.005,EIB_repres_750_within_slope_0.05,EIB_repres_750_within_slope_0.5)
EIB_repres_750_between<-rbind.data.frame(EIB_repres_750_between_slope_0.005,EIB_repres_750_between_slope_0.05,EIB_repres_750_between_slope_0.5)
EIB_repres_750_within$Sub<-paste0("Sub",1:nrow(EIB_repres_750_within))
EIB_repres_750_between$Sub<-paste0("Sub",1:nrow(EIB_repres_750_between))
EIB_repres_750_within$Type<-"Within"
EIB_repres_750_between$Type<-"Between"
require(Rmisc)
