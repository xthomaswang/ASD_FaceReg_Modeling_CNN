#######################
#######################
###1000 epoch
#read in the data & ###calculate the within-P vs. between-P correlation
setwd("/Users/lchen4/Documents/Research/LCCN related/ASD Face Memory_Modeling/Data analysis/EIBResult/1000/cor_output_CSV/")
require(magic)
##construct diagnal matrix
dia_matrix<-matrix(T, 4, 4)
dia_matrix_block<-adiag(dia_matrix,dia_matrix,dia_matrix,dia_matrix,dia_matrix,dia_matrix,dia_matrix,dia_matrix,dia_matrix,dia_matrix)
for (j in c(0.5,0.05,0.005)) {
for (i in 0:19) {
cor_temp<-read.csv(paste0("cor_output_1000_",j,"_",i,".csv"),header = T, na.strings = "NA")[,-1]
###remove the first image of all P identity (which is used for testing)
cor_temp<-cor_temp[-which(1:nrow(cor_temp)%%5==1),-which(1:ncol(cor_temp)%%5==1)]
if (i == 0) {
EIB_mean_repres<-cor_temp
assign(paste0("EIB_repres_1000_within_slope_",j), cor_temp[(lower.tri(cor_temp) & dia_matrix_block)])
assign(paste0("EIB_repres_1000_between_slope_",j), cor_temp[(lower.tri(cor_temp) & !dia_matrix_block)])
} else {
EIB_mean_repres<-EIB_mean_repres+cor_temp
assign(paste0("EIB_repres_1000_within_slope_",j), rbind.data.frame(get(paste0("EIB_repres_1000_within_slope_",j)),
cor_temp[(lower.tri(cor_temp) & dia_matrix_block)]))
assign(paste0("EIB_repres_1000_between_slope_",j), rbind.data.frame(get(paste0("EIB_repres_1000_between_slope_",j)),
cor_temp[(lower.tri(cor_temp) & !dia_matrix_block)]))
}
}
assign(paste0("EIB_mean_repres_slope_",j),EIB_mean_repres/20)
}
colnames(EIB_repres_1000_within_slope_0.005)<-paste0("wcor",1:dim(EIB_repres_1000_within_slope_0.005)[2])
colnames(EIB_repres_1000_within_slope_0.05)<-paste0("wcor",1:dim(EIB_repres_1000_within_slope_0.05)[2])
colnames(EIB_repres_1000_within_slope_0.5)<-paste0("wcor",1:dim(EIB_repres_1000_within_slope_0.5)[2])
colnames(EIB_repres_1000_between_slope_0.005)<-paste0("bcor",1:dim(EIB_repres_1000_between_slope_0.005)[2])
colnames(EIB_repres_1000_between_slope_0.05)<-paste0("bcor",1:dim(EIB_repres_1000_between_slope_0.05)[2])
colnames(EIB_repres_1000_between_slope_0.5)<-paste0("bcor",1:dim(EIB_repres_1000_between_slope_0.5)[2])
#combine data
EIB_repres_1000_within_slope_0.005$slope<-0.005
EIB_repres_1000_within_slope_0.05$slope<-0.05
EIB_repres_1000_within_slope_0.5$slope<-0.5
EIB_repres_1000_between_slope_0.005$slope<-0.005
EIB_repres_1000_between_slope_0.05$slope<-0.05
EIB_repres_1000_between_slope_0.5$slope<-0.5
EIB_repres_1000_within<-rbind.data.frame(EIB_repres_1000_within_slope_0.005,EIB_repres_1000_within_slope_0.05,EIB_repres_1000_within_slope_0.5)
EIB_repres_1000_between<-rbind.data.frame(EIB_repres_1000_between_slope_0.005,EIB_repres_1000_between_slope_0.05,EIB_repres_1000_between_slope_0.5)
EIB_repres_1000_within$Sub<-paste0("Sub",1:nrow(EIB_repres_1000_within))
EIB_repres_1000_between$Sub<-paste0("Sub",1:nrow(EIB_repres_1000_between))
EIB_repres_1000_within$Type<-"Within"
EIB_repres_1000_between$Type<-"Between"
require(Rmisc)
require(reshape2)
require(ggplot2)
EIB_repres_1000_within_long<-melt(EIB_repres_1000_within,id.vars = c("Sub","slope","Type"),variable.name = "pair",value.name = "corr")
EIB_repres_1000_betw_long<-melt(EIB_repres_1000_between,id.vars = c("Sub","slope","Type"),variable.name = "pair",value.name = "corr")
EIB_repres_1000_long<-rbind.data.frame(EIB_repres_1000_within_long,EIB_repres_1000_betw_long)
EIB_repres_1000_long$Sub<-as.factor(EIB_repres_1000_long$Sub)
EIB_repres_1000_long$slope<-as.factor(EIB_repres_1000_long$slope)
EIB_repres_1000_long$slope<-factor(EIB_repres_1000_long$slope,levels = c("0.005","0.05","0.5"))
##ANOVA
require(rstatix)
EIB_repres_1000_sum<-summarySE(EIB_repres_1000_long,measurevar = "corr",groupvars = c("Sub","slope","Type"),na.rm = T)
sink(file = "/Users/lchen4/Documents/Research/LCCN related/ASD Face Memory_Modeling/Data analysis/EIB_repres_1000_ANOVA.txt")
anova_test(corr~slope*Type+Error(Sub/Type),data=EIB_repres_1000_sum,effect.size = "pes",type = 3)
##post hoc
aov(corr~slope, data = EIB_repres_1000_sum[EIB_repres_1000_sum$Type=="Within",]) %>% tukey_hsd()
aov(corr~slope, data = EIB_repres_1000_sum[EIB_repres_1000_sum$Type=="Between",]) %>% tukey_hsd()
sink()
##plot
EIB_repres_1000_grand_sum<-summarySE(EIB_repres_1000_sum[,c(1,2,3,5)],measurevar = "corr",groupvars = c("slope","Type"),na.rm = T)
write.csv(EIB_repres_1000_sum,
file = "/Users/lchen4/Documents/Research/LCCN related/ASD Face Memory_Modeling/Data analysis/EIB_repres_1000_individual.csv",row.names = F)
write.csv(EIB_repres_1000_grand_sum,
file = "/Users/lchen4/Documents/Research/LCCN related/ASD Face Memory_Modeling/Data analysis/EIB_repres_1000_grandmean.csv",row.names = F)
