set.seed(1)
##################EIB part
###500 epoch
#read in the data & ###calculate the within-P vs. between-P correlation
setwd("./EIBResult/500/cor_output_CSV/")
require(magic)
##construct diagnal matrix
dia_matrix<-matrix(T, 4, 4) ## 4 images for training
dia_matrix_block<-adiag(dia_matrix,dia_matrix,dia_matrix,dia_matrix,dia_matrix,dia_matrix,dia_matrix,dia_matrix,dia_matrix,dia_matrix)
for (j in c(0.5,0.05,0.005)) {
for (i in 0:19) {
cor_temp<-read.csv(paste0("cor_output_500_",j,"_",i,".csv"),header = T, na.strings = "NA")[,-1]
###remove the first image of all P identity (which is used for testing)
cor_temp<-cor_temp[-which(1:nrow(cor_temp)%%5==1),-which(1:ncol(cor_temp)%%5==1)]
if (i == 0) {
EIB_mean_repres<-cor_temp
assign(paste0("EIB_repres_500_within_slope_",j), cor_temp[(lower.tri(cor_temp) & dia_matrix_block)])
assign(paste0("EIB_repres_500_between_slope_",j), cor_temp[(lower.tri(cor_temp) & !dia_matrix_block)])
} else {
EIB_mean_repres<-EIB_mean_repres+cor_temp
assign(paste0("EIB_repres_500_within_slope_",j), rbind.data.frame(get(paste0("EIB_repres_500_within_slope_",j)),
cor_temp[(lower.tri(cor_temp) & dia_matrix_block)]))
assign(paste0("EIB_repres_500_between_slope_",j), rbind.data.frame(get(paste0("EIB_repres_500_between_slope_",j)),
cor_temp[(lower.tri(cor_temp) & !dia_matrix_block)]))
}
}
assign(paste0("EIB_mean_repres_slope_",j),EIB_mean_repres/20)
}
colnames(EIB_repres_500_within_slope_0.005)<-paste0("wcor",1:dim(EIB_repres_500_within_slope_0.005)[2])
colnames(EIB_repres_500_within_slope_0.05)<-paste0("wcor",1:dim(EIB_repres_500_within_slope_0.05)[2])
colnames(EIB_repres_500_within_slope_0.5)<-paste0("wcor",1:dim(EIB_repres_500_within_slope_0.5)[2])
colnames(EIB_repres_500_between_slope_0.005)<-paste0("bcor",1:dim(EIB_repres_500_between_slope_0.005)[2])
colnames(EIB_repres_500_between_slope_0.05)<-paste0("bcor",1:dim(EIB_repres_500_between_slope_0.05)[2])
colnames(EIB_repres_500_between_slope_0.5)<-paste0("bcor",1:dim(EIB_repres_500_between_slope_0.5)[2])
#combine data
EIB_repres_500_within_slope_0.005$slope<-0.005
EIB_repres_500_within_slope_0.05$slope<-0.05
EIB_repres_500_within_slope_0.5$slope<-0.5
EIB_repres_500_between_slope_0.005$slope<-0.005
EIB_repres_500_between_slope_0.05$slope<-0.05
EIB_repres_500_between_slope_0.5$slope<-0.5
EIB_repres_500_within<-rbind.data.frame(EIB_repres_500_within_slope_0.005,EIB_repres_500_within_slope_0.05,EIB_repres_500_within_slope_0.5)
EIB_repres_500_between<-rbind.data.frame(EIB_repres_500_between_slope_0.005,EIB_repres_500_between_slope_0.05,EIB_repres_500_between_slope_0.5)
EIB_repres_500_within$Sub<-paste0("Sub",1:nrow(EIB_repres_500_within))
EIB_repres_500_between$Sub<-paste0("Sub",1:nrow(EIB_repres_500_between))
EIB_repres_500_within$Type<-"Within"
EIB_repres_500_between$Type<-"Between"
require(Rmisc)
require(reshape2)
require(ggplot2)
require(ggbeeswarm)
EIB_repres_500_within_long<-melt(EIB_repres_500_within,id.vars = c("Sub","slope","Type"),variable.name = "pair",value.name = "corr")
EIB_repres_500_betw_long<-melt(EIB_repres_500_between,id.vars = c("Sub","slope","Type"),variable.name = "pair",value.name = "corr")
EIB_repres_500_long<-rbind.data.frame(EIB_repres_500_within_long,EIB_repres_500_betw_long)
EIB_repres_500_long$Sub<-as.factor(EIB_repres_500_long$Sub)
EIB_repres_500_long$slope<-as.factor(EIB_repres_500_long$slope)
EIB_repres_500_long$slope<-factor(EIB_repres_500_long$slope,levels = c("0.005","0.05","0.5"))
##ANOVA
require(rstatix)
EIB_repres_500_sum<-summarySE(EIB_repres_500_long,measurevar = "corr",groupvars = c("Sub","slope","Type"),na.rm = T)
sink(file = "/Users/lchen4/Documents/Research/LCCN related/ASD Face Memory_Modeling/Data analysis/EIB_repres_500_ANOVA.txt")
anova_test(corr~slope*Type+Error(Sub/Type),data=EIB_repres_500_sum,effect.size = "pes",type = 3)
##post hoc
aov(corr~slope, data = EIB_repres_500_sum[EIB_repres_500_sum$Type=="Within",]) %>% tukey_hsd()
aov(corr~slope, data = EIB_repres_500_sum[EIB_repres_500_sum$Type=="Between",]) %>% tukey_hsd()
sink()
##plot
EIB_repres_500_grand_sum<-summarySE(EIB_repres_500_sum[,c(1,2,3,5)],measurevar = "corr",groupvars = c("slope","Type"),na.rm = T)
write.csv(EIB_repres_500_sum,
file = "/Users/lchen4/Documents/Research/LCCN related/ASD Face Memory_Modeling/Data analysis/EIB_repres_500_individual.csv",row.names = F)
write.csv(EIB_repres_500_grand_sum,
file = "/Users/lchen4/Documents/Research/LCCN related/ASD Face Memory_Modeling/Data analysis/EIB_repres_500_grandmean.csv",row.names = F)
barplot_500<-ggplot(EIB_repres_500_sum,aes(x = slope, y = corr,fill = Type)) +
geom_boxplot(width=.3, outlier.shape = NA,
position = position_dodge2(preserve = "single"),size = 0.8,alpha = 0.5) +
#geom_violin(alpha = 0.5,position = position_dodge(0.3)) +
geom_quasirandom(aes(colour = Type), groupOnX = TRUE,
width=.1, dodge.width = 0.3) +
scale_color_manual(values = c("#6CC6D8","#EE7564")) +
scale_fill_manual(values = c("#B5E5EF","#F8C9C4")) +
scale_y_continuous(name = "NRS (r)",limits = c(0,1)) +
ggtitle("Epoch = 500") +
theme_classic()
barplot_500<-barplot_500 +
theme(plot.title = element_text(color="gray20", size=8, face="bold",hjust = 0.5),
plot.margin = margin(0,0,0,0, 'cm'),
legend.title = element_text(size = 10),
legend.text = element_text(size = 8))
